# ---- Database ----
DATABASE_URL="postgresql://portal:portal@localhost:5432/corporate_portal?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- LDAP / Active Directory ----
# LDAP(S) URL of the domain controller, e.g. ldaps://dc01.corp.example.com:636
LDAP_URL=""
# Service account used to bind and search the directory (not the end user), e.g. CN=svc-portal,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
# Base DN to search users under, e.g. OU=Users,DC=corp,DC=example,DC=com
LDAP_BASE_DN=""
# Search filter, %s is replaced with the submitted login, e.g. (sAMAccountName=%s)
LDAP_SEARCH_FILTER="(sAMAccountName=%s)"
# Optional: filter used by the admin-triggered "Sync with AD" org-structure
# import (Admin panel -> Synchronization with AD). Defaults to all enabled
# person accounts if not set; override if your AD schema needs something
# different (e.g. excluding service accounts under a specific OU).
# LDAP_SYNC_FILTER="(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))"
# Optional: restricts the org-structure sync to a single OU instead of
# searching all of LDAP_BASE_DN, e.g. OU=Head Office,OU=Users,DC=corp,DC=example,DC=com
# Useful for testing the sync on a small branch before running it org-wide.
# LDAP_SYNC_BASE_DN=""

# ---- Local development only ----
# When "true" and LDAP_URL is not set, the Credentials provider accepts any
# username/password and logs in as a fake local user instead of binding to LDAP.
# Must never be enabled in production.
AUTH_DEV_MODE="false"

# ---- Seed script only (optional) ----
# sAMAccountName that should receive the ADMIN role on first seed. Defaults to
# "admin" if not set. Not read by the application itself.
ADMIN_LDAP_UID=""

# ---- Build-time corporate proxy (optional) ----
# Only needed if the Docker build host has no direct internet access and must
# go through a proxy to reach the Alpine/npm package repositories. Passed to
# `docker build` as --build-arg by docker-compose.yml; NOT used at container
# runtime (the Dockerfile clears these in the final image).
# HTTP_PROXY="http://proxy.example.com:3128"
# HTTPS_PROXY="http://proxy.example.com:3128"
# NO_PROXY="localhost,127.0.0.1,.corp.example.com"
