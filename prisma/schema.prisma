generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum ItRequestStatus {
  OPEN
  RESOLVED
}

model User {
  id          String    @id @default(cuid())
  ldapUid     String    @unique
  email       String    @unique
  displayName String
  role        Role      @default(EMPLOYEE)

  canBookRooms Boolean  @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  bookingsOrganized     Booking[] @relation("BookingOrganizer")
  bookingsParticipating Booking[] @relation("BookingParticipants")
  notifications         Notification[]
  news                  News[]
  newsLikes             NewsLike[]
  newsComments          NewsComment[]
  auditLogs             AuditLog[]
  itRequests            ItRequest[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([displayName])
}

model Department {
  id       String  @id @default(cuid())
  name     String
  parentId String?

  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")

  // Explicit head of this department, assigned by an admin. When unset, the
  // UI falls back to the highest-ranked employee in the department (see
  // resolveHead() in lib/org-tree.ts) so the chart never looks empty.
  headEmployeeId String?
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id])

  // Manual sibling ordering for the org chart (lower first).
  order Int @default(0)
  // Hidden departments are skipped when rendering the public org chart's
  // navigation, but remain fully editable in the admin panel.
  isPublished Boolean @default(true)

  employees Employee[]
  vacancies Vacancy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([headEmployeeId])
}

model Position {
  id    String @id @default(cuid())
  title String @unique
  // Seniority for sorting employees within a department (higher = more
  // senior). Unranked positions default to 0 and sort last.
  rank  Int    @default(0)

  employees Employee[]
  vacancies Vacancy[]
}

// Open (unfilled) positions, imported from the bank's staffing sheet.
// Deliberately separate from Employee - a vacancy has no person, no email,
// and re-importing replaces the whole list wholesale (see lib/vacancy-import.ts).
model Vacancy {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  note String?

  createdAt DateTime @default(now())

  @@index([departmentId])
}

model Employee {
  id       String  @id @default(cuid())
  fullName String
  email    String  @unique
  phone    String?
  photoUrl String?
  birthDate DateTime?
  hireDate  DateTime?
  bio      String?
  // Free-text "field of activity / direction" - distinct from the formal
  // Position title, self-described by the employee (e.g. "Backend-разработка").
  activityArea String?

  vacationDaysTotal Int @default(28)
  vacationDaysUsed  Int @default(0)

  // Current/upcoming vacation window - drives the "on vacation" badge shown
  // on the employee's org-structure card. Just one active range at a time,
  // set by HR; not a history log.
  vacationStart DateTime?
  vacationEnd   DateTime?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  user      User?
  workplace Workplace?

  headOfDepartments Department[] @relation("DepartmentHead")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([departmentId])
}

model News {
  id          String  @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  documentUrl  String?
  documentName String?
  isPublished Boolean @default(true)
  isPinned    Boolean @default(false)
  views       Int     @default(0)

  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  likes    NewsLike[]
  comments NewsComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, isPinned, createdAt])
  @@index([categoryId])
}

model NewsCategory {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  news News[]

  createdAt DateTime @default(now())
}

// Deliberately onDelete: Cascade (unlike the rest of the schema's default
// Restrict) - a like/comment has no meaning without its News post, and
// without cascading, deleting an old news post would be blocked until its
// engagement rows were cleaned up by hand.
model NewsLike {
  id     String @id @default(cuid())
  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([newsId, userId])
  @@index([newsId])
}

model NewsComment {
  id       String @id @default(cuid())
  newsId   String
  news     News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())

  @@index([newsId])
}

model ResourceLink {
  id          String  @id @default(cuid())
  title       String
  url         String
  description String?
  // Name of a lucide-react icon shown in the sidebar - see lib/resource-link-icons.ts
  // for the allowed set. Free string (not a DB enum) to keep the icon list
  // easy to extend without a migration.
  icon        String  @default("Link")
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Admin/HR-managed onboarding tips shown on the "Компас новичка" page -
// lets HR fill in real company-specific facts (dress code, first-day
// logistics, etc.) without the app inventing anything.
model CompassTip {
  id      String @id @default(cuid())
  title   String
  content String
  order   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Admin/HR-managed onboarding checklist shown on "Компас новичка" -
// stageId is a plain string (not a Prisma enum) because its allowed values
// are already fixed in code (lib/compass/mock-data.ts -> ONBOARDING_STAGES)
// and validated via zod; a DB enum would just make future stage changes
// harder to migrate for no real safety gain.
model OnboardingTask {
  id      String @id @default(cuid())
  title   String
  stageId String
  order   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, order])
}

// Admin/HR-managed FAQ shown on "Компас новичка".
model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Admin/HR-managed document library ("Документы") - a real uploaded file
// (unlike ResourceLink, which is just an external URL), served through the
// same public/uploads pipeline as News document attachments.
model Document {
  id          String  @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Self-service IT support request ("IT-сервисы"). Notifies every ADMIN user
// (not a heuristically-matched "IT department") since that's the one
// reliable recipient this schema can guarantee.
model ItRequest {
  id          String          @id @default(cuid())
  subject     String
  description String
  status      ItRequestStatus @default(OPEN)

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
}

// Admin/HR-managed "Внимание" panel on the home page - deliberately its own
// model rather than reusing News.isPinned, since these are meant to be
// short standalone notices, not full articles.
model Announcement {
  id    String @id @default(cuid())
  title String
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Holiday {
  id    String   @id @default(cuid())
  title String
  date  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  summary    String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  floor     Int
  equipment String[]
  // Out-of-service rooms stay in history/existing bookings but are hidden
  // from the booking form and "find a free room" search.
  isActive  Boolean  @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id    String @id @default(cuid())
  topic String

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  organizerId String
  organizer   User   @relation("BookingOrganizer", fields: [organizerId], references: [id])

  participants User[] @relation("BookingParticipants")

  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)

  // Groups the individual occurrences created together for a recurring
  // meeting - each occurrence is its own Booking row with its own overlap
  // check, not a computed series.
  recurrenceGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, startTime, endTime])
  @@index([recurrenceGroupId])
  @@index([organizerId])
}

// In-app notification feed (bell icon). Also triggers a best-effort email
// via lib/email.ts, which is a no-op until SMTP_* env vars are configured.
model Notification {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  type    String
  title   String
  message String
  link    String?
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Admin-managed photo spotlight carousel for the home page ("Team members
// in action") - separate from News since it's a lightweight rotating photo
// gallery, not an article.
model TeamSpotlight {
  id       String @id @default(cuid())
  imageUrl String
  caption  String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Workplace {
  id         String  @id @default(cuid())
  building   String?
  floor      Int
  room       String
  deskNumber String
  positionX  Float?
  positionY  Float?

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([floor])
  @@index([building])
}
