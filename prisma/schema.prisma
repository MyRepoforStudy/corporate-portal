generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id          String    @id @default(cuid())
  ldapUid     String    @unique
  email       String    @unique
  displayName String
  role        Role      @default(EMPLOYEE)

  canBookRooms Boolean  @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  bookingsOrganized     Booking[] @relation("BookingOrganizer")
  bookingsParticipating Booking[] @relation("BookingParticipants")
  notifications         Notification[]
  news                  News[]
  auditLogs             AuditLog[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([displayName])
}

model Department {
  id       String  @id @default(cuid())
  name     String
  parentId String?

  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")

  // Explicit head of this department, assigned by an admin. When unset, the
  // UI falls back to the highest-ranked employee in the department (see
  // resolveHead() in lib/org-tree.ts) so the chart never looks empty.
  headEmployeeId String?
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id])

  // Manual sibling ordering for the org chart (lower first).
  order Int @default(0)
  // Hidden departments are skipped when rendering the public org chart's
  // navigation, but remain fully editable in the admin panel.
  isPublished Boolean @default(true)

  employees Employee[]
  vacancies Vacancy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([headEmployeeId])
}

model Position {
  id    String @id @default(cuid())
  title String @unique
  // Seniority for sorting employees within a department (higher = more
  // senior). Unranked positions default to 0 and sort last.
  rank  Int    @default(0)

  employees Employee[]
  vacancies Vacancy[]
}

// Open (unfilled) positions, imported from the bank's staffing sheet.
// Deliberately separate from Employee - a vacancy has no person, no email,
// and re-importing replaces the whole list wholesale (see lib/vacancy-import.ts).
model Vacancy {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  note String?

  createdAt DateTime @default(now())

  @@index([departmentId])
}

model Employee {
  id       String  @id @default(cuid())
  fullName String
  email    String  @unique
  phone    String?
  photoUrl String?
  birthDate DateTime?
  hireDate  DateTime?
  bio      String?
  // Free-text "field of activity / direction" - distinct from the formal
  // Position title, self-described by the employee (e.g. "Backend-разработка").
  activityArea String?

  vacationDaysTotal Int @default(28)
  vacationDaysUsed  Int @default(0)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  user      User?
  workplace Workplace?

  vacations Vacation[]

  headOfDepartments Department[] @relation("DepartmentHead")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([departmentId])
}

model News {
  id          String  @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  documentUrl  String?
  documentName String?
  isPublished Boolean @default(true)
  isPinned    Boolean @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, isPinned, createdAt])
}

model ResourceLink {
  id          String  @id @default(cuid())
  title       String
  url         String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Holiday {
  id    String   @id @default(cuid())
  title String
  date  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// A logged date range an employee is away - purely informational for the
// company calendar. Deliberately not linked to Employee.vacationDaysUsed
// (the HR-managed remaining-balance counter on the profile page), which
// uses its own manual accounting rules and would risk drifting out of sync.
model Vacation {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([startDate])
  @@index([endDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  summary    String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  floor     Int
  equipment String[]
  // Out-of-service rooms stay in history/existing bookings but are hidden
  // from the booking form and "find a free room" search.
  isActive  Boolean  @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id    String @id @default(cuid())
  topic String

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  organizerId String
  organizer   User   @relation("BookingOrganizer", fields: [organizerId], references: [id])

  participants User[] @relation("BookingParticipants")

  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)

  // Groups the individual occurrences created together for a recurring
  // meeting - each occurrence is its own Booking row with its own overlap
  // check, not a computed series.
  recurrenceGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, startTime, endTime])
  @@index([recurrenceGroupId])
  @@index([organizerId])
}

// In-app notification feed (bell icon). Also triggers a best-effort email
// via lib/email.ts, which is a no-op until SMTP_* env vars are configured.
model Notification {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  type    String
  title   String
  message String
  link    String?
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Admin-managed photo spotlight carousel for the home page ("Team members
// in action") - separate from News since it's a lightweight rotating photo
// gallery, not an article.
model TeamSpotlight {
  id       String @id @default(cuid())
  imageUrl String
  caption  String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Workplace {
  id         String  @id @default(cuid())
  building   String?
  floor      Int
  room       String
  deskNumber String
  positionX  Float?
  positionY  Float?

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([floor])
  @@index([building])
}
