generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id          String    @id @default(cuid())
  ldapUid     String    @unique
  email       String    @unique
  displayName String
  role        Role      @default(EMPLOYEE)

  canBookRooms Boolean  @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  bookingsOrganized     Booking[] @relation("BookingOrganizer")
  bookingsParticipating Booking[] @relation("BookingParticipants")
  news                  News[]
  auditLogs             AuditLog[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([displayName])
}

model Department {
  id       String  @id @default(cuid())
  name     String
  parentId String?

  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")

  employees Employee[]
  vacancies Vacancy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Position {
  id    String @id @default(cuid())
  title String @unique
  // Seniority for sorting employees within a department (higher = more
  // senior). Unranked positions default to 0 and sort last.
  rank  Int    @default(0)

  employees Employee[]
  vacancies Vacancy[]
}

// Open (unfilled) positions, imported from the bank's staffing sheet.
// Deliberately separate from Employee - a vacancy has no person, no email,
// and re-importing replaces the whole list wholesale (see lib/vacancy-import.ts).
model Vacancy {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  note String?

  createdAt DateTime @default(now())

  @@index([departmentId])
}

model Employee {
  id       String  @id @default(cuid())
  fullName String
  email    String  @unique
  phone    String?
  photoUrl String?
  birthDate DateTime?
  hireDate  DateTime?
  bio      String?

  vacationDaysTotal Int @default(28)
  vacationDaysUsed  Int @default(0)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  user      User?
  workplace Workplace?

  recognitionsGiven    Recognition[] @relation("RecognitionFrom")
  recognitionsReceived Recognition[] @relation("RecognitionTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([departmentId])
}

model News {
  id          String  @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  documentUrl  String?
  documentName String?
  isPublished Boolean @default(true)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, createdAt])
}

model ResourceLink {
  id          String  @id @default(cuid())
  title       String
  url         String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Holiday {
  id    String   @id @default(cuid())
  title String
  date  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  summary    String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  floor     Int
  equipment String[]

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id    String @id @default(cuid())
  topic String

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  organizerId String
  organizer   User   @relation("BookingOrganizer", fields: [organizerId], references: [id])

  participants User[] @relation("BookingParticipants")

  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, startTime, endTime])
  @@index([organizerId])
}

// Peer-to-peer public kudos shown on the home page - "X thanked Y for...".
model Recognition {
  id      String  @id @default(cuid())
  title   String
  message String?

  fromEmployeeId String
  fromEmployee   Employee @relation("RecognitionFrom", fields: [fromEmployeeId], references: [id])

  toEmployeeId String
  toEmployee   Employee @relation("RecognitionTo", fields: [toEmployeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([toEmployeeId])
  @@index([createdAt])
}

// Admin-managed photo spotlight carousel for the home page ("Team members
// in action") - separate from News since it's a lightweight rotating photo
// gallery, not an article.
model TeamSpotlight {
  id       String @id @default(cuid())
  imageUrl String
  caption  String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Workplace {
  id         String  @id @default(cuid())
  building   String?
  floor      Int
  room       String
  deskNumber String
  positionX  Float?
  positionY  Float?

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([floor])
  @@index([building])
}
